# Copy to .env.production (or set in your host's dashboard) for the live build.

# The public address, no trailing slash. Turns on absolute link-preview URLs,
# the canonical link and sitemap.xml.
VITE_SITE_URL=

# Day No. 1 of the Daily Quali (YYYY-MM-DD). Numbering, the circuit rotation,
# the conditions and the archive all count from here. Set it to launch day.
VITE_LAUNCH_DATE=

# Google AdSense (see docs/ADS.md). Leave empty to ship without ads.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_RAIL=
VITE_ADSENSE_SLOT_INLINE=

# Plausible analytics (cookieless). The site's domain as set up in Plausible,
# e.g. apex.example. Leave empty for no analytics. VITE_PLAUSIBLE_SRC only for
# a self-hosted or proxied script.
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=

# Shown on the privacy page as the contact address. Optional.
VITE_CONTACT_EMAIL=
