{
  "name": "apex",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "build:tracks": "tsx tools/track-builder/src/build-tracks.ts",
    "build:outlines": "tsx tools/track-builder/src/build-outlines.ts",
    "build:scenery": "tsx tools/track-builder/src/import-osm.ts && tsx tools/track-builder/src/trim-scenery.ts",
    "compare": "tsx tools/track-builder/src/compare-lines.ts",
    "check": "tsx tools/track-builder/src/check-tracks.ts",
    "dev": "npm run dev -w @apex/web",
    "build:web": "npm run build -w @apex/web"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "@types/node": "^24.0.0"
  }
}
